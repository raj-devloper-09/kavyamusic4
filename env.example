# ================================
# Telegram API credentials
# Get from https://my.telegram.org -> API Development Tools
# ================================
API_ID=1234567
API_HASH=your_api_hash_here

# ================================
# Bot Token
# Get from @BotFather on Telegram
# ================================
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# Assistant account session string
# This is a NORMAL Telegram user account (not a bot) that joins
# the group's video chat and actually streams the video.
# Generate this ONE TIME using generate_session.py (included)
# ================================
SESSION_STRING=paste_generated_session_string_here

# ================================
# Optional: comma separated list of user IDs allowed to use /vplay
# Leave empty to allow everyone
# ================================
SUDO_USERS=

# ================================
# Log group/channel ID (optional) - bot sends errors/logs here
# ================================
LOG_GROUP_ID=
